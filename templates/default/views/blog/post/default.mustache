{{<html}}
{{$main}}

<div class="article-with-toc">
    <div>
        <article class="post">
            <div class="meta">            
                <time datetime="{{page.publication.iso8601}}">{{page.publication.date.short}} {{page.publication.time.short}}</time>
                {{#page.contents.readingTime}} &middot; <span class="reading-time">{{.}} min read</span>{{/page.contents.readingTime}}
                {{#page.featured}} &middot; <span class="featured">featured</span>{{/page.featured}}
            </div>
            <h1>{{page.title}}</h1>
            <hr>
            <p>{{page.description}}</p>
            <section>
            
            {{& page.contents.html}}
                
            </section>

            <footer>
                <br>
                <time datetime="{{page.date}}">{{page.date}}</time>

                
                <div class="author-list">
                {{#page.authors}}
                    <a href="{{permalink}}">
                    {{#image}}<img class="small rounded" src="{{.}}" alt="{{title}}">{{/image}}
                    </a>
                {{/page.authors}}
                </div>
                <div class="tag-list">
                {{#page.tags}}
                    <a href="{{permalink}}"><small>{{title}}</small></a>
                {{/page.tags}}
                </div>
                
                <p>
                    <a href="https://x.com/intent/tweet?via=tiborbodecs&amp;hashtags=SwiftLang&amp;url={{page.permalink}}" target="_blank">
                        <strong>Share this article</strong>
                    </a>
                    <br>Thank you. 🙏
                </p>
            </footer>
                        
            <section class="group">
                {{#empty(page.related)}}
                {{/empty(page.related)}}
                {{^empty(page.related)}}
                <h4>Related posts</h4>                
                <div class="grid grid-221">
                {{#page.related}}
                    {{> partials.blog.post}}
                {{/page.related}}
                </div>
                {{/empty(page.related)}}
            </section>

        </article>
    </div>
    
    <div>
        <div class="book">
            <a href="https://learntocodeusingswift.com/?source=theswiftdev" target="_blank">
                <img src="{{baseUrl}}/assets/learn-to-code-using-swift/cover.jpeg" alt="Learn To Code Using Swift cover image">
            </a>
            <p>Start learning today—only $49.</p>
            <a class="cta" href="https://theswiftdev.gumroad.com/l/learn-to-code-using-swift" target="_blank">Buy on Gumroad</a>
        </div>
        
        {{> partials.outline }}

    </div>
</div>

{{/main}}
{{/html}}
